SELECT to_timestamp(ts/1000) AT TIME ZONE 'America/Sao_Paulo' AS momento,
         str_v,
         round((ts - lag(ts) OVER (ORDER BY ts))/1000.0/60, 1) AS min_desde_anterior
  FROM ts_kv
  WHERE entity_id = '68c8aee1-f143-11ef-a212-67802bff4221'   -- Motor Ligado (PG)
    AND key = 58
    AND ts >= 1779134400000 AND ts < 1779192000000           -- 18/05 17:00 → 19/05 09:00 GMT-3
  ORDER BY ts;

